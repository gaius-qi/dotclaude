        <mxCell id="c23" value="\(\mathit{TotalScore} = 0.6\,\mathit{LoadQuality} + 0.2\,\mathit{IDC} + 0.1\,\mathit{Location} + 0.1\,\mathit{HostType}\)" style="whiteSpace=wrap;html=1;fontColor=#000000;fontSize=14;rounded=1;arcSize=10;strokeColor=none;fillColor=#FFF8E6;" vertex="1" parent="1"><mxGeometry x="700" y="252" width="860" height="44" as="geometry"/></mxCell>
