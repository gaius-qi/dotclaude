        <mxCell id="c51" value="\(\begin{aligned}\mathit{idle}_i &amp;= \mathit{max\_tx}_i - \mathit{tx}_i\\ w_i &amp;= \max\big(\mathit{idle}_i,\ \mathit{max\_tx}_i/10\big)\\ P(i) &amp;= \frac{w_i}{\sum_j w_j}\ \ \Rightarrow\ \ B:C:D \approx 6:3:1\end{aligned}\)" style="whiteSpace=wrap;html=1;fontColor=#000000;fontSize=14;rounded=1;arcSize=10;strokeColor=none;fillColor=#F0FAE9;" vertex="1" parent="1"><mxGeometry x="1090" y="790" width="470" height="140" as="geometry"/></mxCell>
